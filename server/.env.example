PORT=3000
# Token del bot que te da @BotFather
BOT_TOKEN=
# Cadena larga y aleatoria (ej: openssl rand -hex 32)
SESSION_SECRET=
# Clave para entrar al panel /admin
ADMIN_KEY=
# 1 = permite jugar en el navegador sin Telegram (solo para pruebas, NUNCA en producción)
DEV_MODE=0

# Economía
COINS_PER_USD=20000
MIN_WITHDRAW_COINS=40000
MAX_WITHDRAWALS_PER_DAY=1
# 0 = sin límite diario
DAILY_COIN_CAP=0
MAX_ADS_PER_DAY=40

# Verificación de anuncios: client | postback
AD_VERIFY_MODE=client
AD_POSTBACK_SECRET=
