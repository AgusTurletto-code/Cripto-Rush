PORT=3000
# Datos que aparecen en los términos y condiciones (/terms)
LEGAL_OWNER=
LEGAL_COUNTRY=
LEGAL_CONTACT=
LEGAL_MIN_AGE=18
# Token del bot que te da @BotFather
BOT_TOKEN=
# Cadena larga y aleatoria (ej: openssl rand -hex 32)
SESSION_SECRET=
# Clave para entrar al panel /admin
ADMIN_KEY=
# 1 = permite jugar en el navegador sin Telegram (solo para pruebas, NUNCA en producción)
DEV_MODE=0

# Economía: tasa automática (monedas por USD = monedas repartidas / (ingresos de anuncios × REVENUE_SHARE))
RATE_MODE=auto
# tasa inicial mientras hay pocos datos (y la fija si RATE_MODE=fixed)
COINS_PER_USD=150000
# porcentaje de lo ganado con anuncios que vuelve a los jugadores
REVENUE_SHARE=0.4
RATE_WINDOW_DAYS=7
RATE_MIN_REVENUE=1
RATE_MAX_DAILY_CHANGE=0.2
MIN_WITHDRAW_USD=1
MAX_WITHDRAWALS_PER_DAY=1
# 0 = sin límite diario
DAILY_COIN_CAP=0
MAX_ADS_PER_DAY=40

# Verificación de anuncios: client | postback
AD_VERIFY_MODE=client
AD_POSTBACK_SECRET=

# URL pública del juego (opcional, se detecta sola)
PUBLIC_URL=
